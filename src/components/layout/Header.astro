---
import { getEntry } from "astro:content";
import { cvContent } from "@/data/pages";
import identity from "../../../content/site/index.json";
const cv = await cvContent();
import Logo from "@/components/Logo.astro";
import { menuLinks } from "@/site.config";
const pathname = Astro.url.pathname;
let activePath = pathname;
if (pathname.startsWith("/projects/") && pathname !== "/projects/") {
  const project = await getEntry(
    "project",
    pathname.slice("/projects/".length).replace(/\/$/, ""),
  );
  if (project?.data.kind === "research") activePath = "/research/";
  if (project?.data.kind === "art") activePath = "/art/";
}
const isCurrent = (path: string) =>
  path === "/"
    ? pathname === "/"
    : activePath.startsWith(path) ||
      (path === "/blog/" && pathname.startsWith("/posts/"));
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${identity.site.author} — home`}>
    <Logo class="wordmark-symbol" />
    <span>
      {identity.site.author}<span class="wordmark-dot" aria-hidden="true"
        >.</span
      >
    </span>
  </a>
  <nav aria-label="Main navigation" class="main-nav">
    {
      menuLinks.map((link) => (
        <a
          href={link.path}
          aria-current={isCurrent(link.path) ? "page" : undefined}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
  <a class="header-cv mono" href={cv.href} target="_blank" rel="noopener"
    >{cv.navLabel}<span class="sr-only">
      ({cv.format})</span
    ></a
  >
</header>
