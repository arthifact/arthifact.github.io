---
import identity from "../../../content/site/index.json";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div>
    <a href="/">{identity.site.author}</a>
  </div>
  <div class="footer-links">
    {
      identity.footerLinks.map((link) => <a href={link.href}>{link.label}</a>)
    }<span class="mono">© {year}</span>
  </div>
</footer>
