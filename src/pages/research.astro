---
import { sectionPage } from "@/data/pages";
import { getCollection } from "astro:content";
import PageIntro from "@/components/PageIntro.astro";
import WorkCard from "@/components/WorkCard.astro";
import PageLayout from "@/layouts/Base.astro";
const research = (
  await getCollection("project", ({ data }) => data.kind === "research")
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const page = sectionPage("research");
---

<PageLayout meta={page}>
  <PageIntro
    title={page.title}
  />
  <section class="work-grid" aria-label="Research work">
    {
      research.map((project, index) => (
        <WorkCard project={project} index={index} imageFit="contain" />
      ))
    }
  </section>
</PageLayout>
