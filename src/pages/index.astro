---
import { pageContent } from "@/data/pages";
import { getCollection } from "astro:content";
import OceanStill from "@/components/OceanStill.astro";
import WorkCard from "@/components/WorkCard.astro";
import PageLayout from "@/layouts/Base.astro";

const projects = await getCollection("project");
const { data: home } = await pageContent("home");
const selected = home.selected!.map(({ id, ...copy }) => {
  const project = projects.find((entry) => entry.id === id);
  if (!project) throw new Error(`Selected work is missing: ${id}`);
  return { project, ...copy };
});
---

<PageLayout meta={home} showFooter={false}>
  <div class="home-intro">
    <div class="home-identity">
      <h1>{home.name}<span class="accent-dot">.</span></h1>
      <p>{home.role}</p>
      <p class="home-contact">
        <a href={`mailto:${home.email}`}>{home.email}</a>
      </p>
    </div>
    <OceanStill />
  </div>
  <section class="selected-section" aria-labelledby="selected-title">
    <h2 id="selected-title" class="eyebrow">{home.selectedTitle}</h2>
    <div class="selected-grid">
      {
        selected.map(({ project, title, description }, index) => (
          <WorkCard
            project={project}
            title={title}
            description={description}
            headingLevel={3}
            loading={index < 3 ? "eager" : "lazy"}
            priority={index === 0}
            imageFit={index < 2 ? "contain" : "cover"}
            imageSizes="(max-width: 600px) calc(50vw - 29px), (max-width: 760px) calc(33.333vw - 27px), (max-width: 1050px) calc(33.333vw - 40px), (max-width: 1336px) calc(33.333vw - 51px), 395px"
          />
        ))
      }
    </div>
  </section>
</PageLayout>
